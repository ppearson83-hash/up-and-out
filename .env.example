# Postgres connection (Neon pooled URL in production; local `prisma dev` URL in dev)
DATABASE_URL=
# Optional direct (session-mode) URL for migrations when it differs from DATABASE_URL
DIRECT_URL=
# NextAuth secret: `openssl rand -base64 32`
AUTH_SECRET=
# Public URL of the deployment, used for auth callbacks
AUTH_URL=http://localhost:3000
